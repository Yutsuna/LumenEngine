    'Core',
    'AppCore',
    'Launch',
]

foreach ModuleName : ModuleNames
    ModulePath = ModuleName
    if FileSystem.is_file(ModulePath / 'meson.build')
        subdir(ModulePath)
        ModuleDefinition = ModuleDefinition + { 'SourceDirRel' : ModuleName }
        ModuleDefinitions += [ModuleDefinition]
    endif
endforeach

