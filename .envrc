# .envrc — direnv configuration for Lumen.
#
# One file, two different local toolchains. direnv always evaluates .envrc with
# bash, so this file stays POSIX-sh and branches on the host OS:
#   * Linux / macOS -> the Nix devshell from flake.nix
#   * Windows       -> the repo-local MSYS2 UCRT64 installed in .win-env by
#                      Windows/Setup.ps1
# Neither branch falls back to globally installed compilers or build tools.
#
# The Windows block mirrors LumenToolchain.GetEnvironmentVariables() in
# Windows/LumenDeps/LumenDeps.psm1 — keep both in sync. Values are written in
# Windows form because direnv's `pwsh` export passes strings through verbatim
# (unlike PATH_add, it does not translate a ':' separated POSIX PATH).

_lumen_os="$(uname -s 2>/dev/null || printf '%s' "${OS:-}")"

case "$_lumen_os" in
    MINGW*|MSYS*|CYGWIN*|Windows_NT)
        if ! command -v cygpath >/dev/null 2>&1; then
            log_error "cygpath is required to activate Lumen's Windows toolchain from .envrc."
            return 1
        fi

        # direnv on Windows runs bash from Git Bash/MSYS2. $PWD is a Windows
        # path there (possibly with '/'); -m gives a stable C:/... form.
        _lumen_root="$(cygpath -m "$PWD")"
        _lumen_ucrt="$_lumen_root/.win-env/msys64/ucrt64"
        _lumen_bin="$_lumen_ucrt/bin"

        if [[ ! -x "$_lumen_bin/meson.exe" ]]; then
            log_error "Lumen's Windows toolchain is missing at '$_lumen_bin'. Run '.\\Windows\\Setup.ps1 -NoShell' once, then 'direnv reload'."
            return 1
        fi

        # Prepend the local UCRT64 bin in POSIX form: MSYS converts PATH when
        # direnv dumps the environment for PowerShell, so a POSIX entry becomes
        # a clean Windows path (setting a Windows-form PATH here would be
        # re-split on 'C:' and corrupted). Do every cygpath call before this.
        PATH="$(cygpath -u "$_lumen_bin"):$PATH"
        export PATH
        export CC=gcc
        export CXX=g++
        export PKG_CONFIG="$_lumen_bin/pkgconf.exe"
        export PKG_CONFIG_PATH="$_lumen_ucrt/lib/pkgconfig;$_lumen_ucrt/share/pkgconfig"
        export VK_LAYER_PATH="$_lumen_bin"
        export CCACHE_DIR="$_lumen_root/.win-env/ccache"
        export LUMEN_SHELL=1
        ;;
    *)
        use flake .#default --accept-flake-config
        PATH_add result/bin
        ;;
esac

unset _lumen_os _lumen_root _lumen_ucrt _lumen_bin _lumen_path
