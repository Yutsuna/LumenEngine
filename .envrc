_LUMEN_ENGINE_OS_DETECTED="$(uname -s 2>/dev/null || printf '%s' "${OS:-}")"

case "$_LUMEN_ENGINE_OS_DETECTED" in

    MINGW*|MSYS*|CYGWIN*|Windows_NT)
        if ! command -v cygpath >/dev/null 2>&1; then
            log_error "cygpath is required to activate Lumen's Windows toolchain from .envrc."
            return 1
        fi

        _LUMEN_ENGINE_ROOT="$(cygpath -m "$PWD")"
        _LUMEN_ENGINE_UCTR="$_LUMEN_ENGINE_ROOT/.win-env/msys64/ucrt64"
        _LUMEN_ENGINE_BIN="$_LUMEN_ENGINE_UCTR/bin"

        if [[ ! -x "$_LUMEN_ENGINE_BIN/meson.exe" ]]; then
            log_error "Lumen's Windows toolchain is missing at '$_LUMEN_ENGINE_BIN'. Run '.\\Windows\\Setup.ps1 -NoShell' once, then 'direnv reload'."
            return 1
        fi

        PATH="$(cygpath -u "$_LUMEN_ENGINE_BIN"):$PATH"

        for _LUMEN_ENGINE_DLL_DIR in "$_LUMEN_ENGINE_ROOT"/Build*/Source/Meson/Private; do
            if [[ -d "$_LUMEN_ENGINE_DLL_DIR" ]]; then
                PATH="$(cygpath -u "$_LUMEN_ENGINE_DLL_DIR"):$PATH"
            fi
        done

        export PATH
        export CC=gcc
        export CXX=g++
        export PKG_CONFIG="$_LUMEN_ENGINE_BIN/pkgconf.exe"
        export PKG_CONFIG_PATH="$_LUMEN_ENGINE_UCTR/lib/pkgconfig;$_LUMEN_ENGINE_UCTR/share/pkgconfig"
        export VK_LAYER_PATH="$_LUMEN_ENGINE_BIN"
        export CCACHE_DIR="$_LUMEN_ENGINE_ROOT/.win-env/ccache"
        export LUMEN_SHELL=1
        ;;

    *)
        use flake .#default --accept-flake-config
        PATH_add result/bin
        ;;
esac

unset _LUMEN_ENGINE_OS_DETECTED _LUMEN_ENGINE_ROOT _LUMEN_ENGINE_UCTR _LUMEN_ENGINE_BIN _LUMEN_ENGINE_PATH _LUMEN_ENGINE_DLL_DIR
